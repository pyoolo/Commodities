<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>S&amp;D Report {{ date }}</title>
<style>
  :root { --bg:#fcfcfb; --card:#ffffff; --ink:#0b0b0b; --ink2:#52514e; --line:#e4e3df;
          --pos:#2a78d6; --neg:#c4511f; --accent:#2a78d6; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#1a1a19; --card:#232322; --ink:#f0efec; --ink2:#c3c2b7; --line:#3a3a37;
            --pos:#6da7ec; --neg:#f08a5d; --accent:#6da7ec; }
    img.chart { background:#fcfcfb; }
  }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
         font:15px/1.55 -apple-system, "Segoe UI", Inter, Roboto, sans-serif; }
  main { max-width:1040px; margin:0 auto; padding:32px 16px 64px; }
  header { border-bottom:2px solid var(--ink); padding-bottom:12px; margin-bottom:24px; }
  header h1 { margin:0; font-size:28px; letter-spacing:-.01em; }
  header p { margin:4px 0 0; color:var(--ink2); font-size:13px; }
  nav { display:flex; gap:16px; flex-wrap:wrap; font-size:14px; margin-bottom:8px; }
  nav a { color:var(--accent); text-decoration:none; }
  section.commodity { margin-top:40px; }
  h2 { font-size:22px; margin:0 0 4px; }
  h3 { font-size:16px; margin:28px 0 8px; }
  .asof { color:var(--ink2); font-size:13px; margin:0 0 16px; }
  .kpis { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:10px; margin:16px 0; }
  .kpi { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:12px 14px; }
  .kpi .l { font-size:12px; color:var(--ink2); }
  .kpi .v { font-size:22px; font-weight:650; font-variant-numeric:tabular-nums; }
  .kpi .v.pos { color:var(--pos); } .kpi .v.neg { color:var(--neg); }
  .kpi .u { font-size:12px; color:var(--ink2); margin-left:4px; font-weight:400; }
  ul.bullets { padding-left:20px; } ul.bullets li { margin:6px 0; }
  .house { background:var(--card); border-left:3px solid var(--accent); padding:10px 16px; border-radius:4px; }
  .house p { margin:4px 0; }
  figure { margin:20px 0; background:var(--card); border:1px solid var(--line); border-radius:8px; padding:12px; }
  img.chart { width:100%; height:auto; display:block; border-radius:4px; }
  figcaption { font-size:12px; color:var(--ink2); margin-top:6px; }
  .tbl { overflow-x:auto; margin:8px 0 20px; }
  table { border-collapse:collapse; font-size:13px; font-variant-numeric:tabular-nums; min-width:100%; }
  th, td { padding:5px 8px; border-bottom:1px solid var(--line); text-align:right; white-space:nowrap; }
  th:first-child, td:first-child { text-align:left; }
  th { color:var(--ink2); font-weight:600; border-bottom:1.5px solid var(--ink2); }
  .up { color:var(--pos); } .down { color:var(--neg); }
  .note { color:var(--ink2); font-size:13px; }
  .warn { background:#fff4e5; color:#7a4100; border-radius:6px; padding:8px 12px; font-size:13px; }
  @media (prefers-color-scheme: dark) { .warn { background:#3a2a12; color:#ffd9a3; } }
  footer { margin-top:48px; color:var(--ink2); font-size:12px; border-top:1px solid var(--line); padding-top:12px; }
  @media print { figure, .kpi { break-inside:avoid; } section.commodity { break-before:page; } }
</style>
</head>
<body>
<main>
<header>
  <h1>Supply &amp; Demand Report</h1>
  <p>Generated {{ generated }} · commit {{ commit }} · automatic run from the workbooks in <code>Fundamentals/</code></p>
</header>
<nav>{% for c in commodities %}<a href="#{{ c.key }}">{{ c.title }}</a>{% endfor %}</nav>

{% if warnings %}<p class="warn">{% for w in warnings %}{{ w }}<br>{% endfor %}</p>{% endif %}

{% for c in commodities %}
<section class="commodity" id="{{ c.key }}">
  <h2>{{ c.title }}</h2>
  <p class="asof">{{ c.as_of }}</p>

  <div class="kpis">
  {% for k in c.kpis %}
    <div class="kpi"><div class="l">{{ k.label }}</div>
      <div class="v {{ k.tone or '' }}">{{ k.value }}<span class="u">{{ k.unit }}</span></div></div>
  {% endfor %}
  </div>

  <h3>Key points</h3>
  <ul class="bullets">{% for b in c.bullets %}<li>{{ b|safe }}</li>{% endfor %}</ul>

  {% if c.house_view %}
  <h3>House view (from the workbook)</h3>
  <div class="house">{% for l in c.house_view %}<p>{{ l }}</p>{% endfor %}</div>
  {% endif %}

  <h3>What changed since the previous run</h3>
  {% if c.revisions_html %}<div class="tbl">{{ c.revisions_html|safe }}</div>
  {% else %}<p class="note">{{ c.revisions_note }}</p>{% endif %}

  <h3>Charts</h3>
  {% for ch in c.charts %}
  <figure><img class="chart" src="{{ ch.src }}" alt="{{ ch.title }}"><figcaption><b>{{ ch.title }}.</b> {{ ch.caption }}</figcaption></figure>
  {% endfor %}

  {% for name, html in c.tables %}
  <h3>{{ name }}</h3><div class="tbl">{{ html|safe }}</div>
  {% endfor %}
</section>
{% endfor %}

<footer>
  Numbers come from the workbooks after a full recalculation. Commentary is generated by rules from those numbers.
  Scenario levers and probabilities are assumptions, not data. Not investment advice.
</footer>
</main>
</body>
</html>
